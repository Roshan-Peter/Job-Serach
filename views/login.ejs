<%- include('partials/header', { title: 'Login' }) %>
<%- include('partials/navbar') %>

<main class="d-flex align-items-center justify-content-center min-vh-100 bg-light">
  <div class="card shadow-sm w-100" style="max-width: 440px;">
    <div class="card-body p-4 p-md-5">

      <div class="text-center mb-4">
        <h2 class="fw-bold mb-1">Welcome back</h2>
        <p class="text-muted small">Sign in to your account</p>
      </div>

      <div id="errorContainer">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
      </div>

      <form id="loginForm" action="/login" method="post" novalidate>
        <div class="mb-3">
          <label for="email" class="form-label fw-semibold">Email Address</label>
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
            <input id="email" name="email" type="email" class="form-control"
              placeholder="you@example.com" required />
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label fw-semibold">Password</label>
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-lock"></i></span>
            <input id="password" name="password" type="password" class="form-control"
              placeholder="Your password" required />
            <button class="btn btn-outline-secondary" type="button" id="togglePassword" tabindex="-1">
              <i class="bi bi-eye" id="toggleIcon"></i>
            </button>
          </div>
        </div>

        <div class="d-grid mb-3">
          <button id="submitBtn" class="btn btn-primary btn-lg" type="submit">
            <span id="btnText">Sign In</span>
            <span id="btnSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status"></span>
          </button>
        </div>
      </form>

      <hr class="my-3"/>
      <p class="text-center text-muted small mb-0">
        Don't have an account? <a href="/register" class="text-decoration-none fw-semibold">Register</a>
      </p>

    </div>
  </div>
</main>

<script>
  // toggle password
  document.getElementById('togglePassword').addEventListener('click', () => {
    const input = document.getElementById('password');
    const icon = document.getElementById('toggleIcon');
    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    icon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
  });

  // submit via fetch
  document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const errorContainer = document.getElementById('errorContainer');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');

    errorContainer.innerHTML = '';
    submitBtn.disabled = true;
    btnText.textContent = 'Signing in…';
    btnSpinner.classList.remove('d-none');

    const payload = Object.fromEntries(new FormData(e.target).entries());

    try {
      const res = await fetch('/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) {
        errorContainer.innerHTML = `
          <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>${data.error || 'Login failed'}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>`;
        // if unconfirmed email, redirect to otp
        if (data.redirect) setTimeout(() => { window.location.href = data.redirect; }, 1200);
      } else {
        window.location.href = data.redirect || '/dashboard';
      }
    } catch {
      errorContainer.innerHTML = `
        <div class="alert alert-danger py-2">
          <i class="bi bi-wifi-off me-2"></i>Network error. Please try again.
        </div>`;
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = 'Sign In';
      btnSpinner.classList.add('d-none');
    }
  });
</script>

<%- include('partials/footer') %>