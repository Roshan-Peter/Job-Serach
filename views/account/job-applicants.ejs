<%- include('../partials/header') %>
    <%- include('../partials/navbar') %>

        <div class="container py-5">

            <!-- HEADER -->
            <div class="mb-4">
                <h3 class="fw-bold">Applicants for <%= job.title %>
                </h3>
                <p class="text-muted mb-0">
                    <%= job.company %> • <%= job.location %>
                </p>
            </div>

            <% if (applications.length===0) { %>

                <div class="text-center py-5 text-muted">
                    <h5>No applicants yet</h5>
                </div>

                <% } else { %>

                    <div class="row g-3">

                        <% applications.forEach(app=> { %>

                            <div class="col-md-6 col-lg-4">

                                <div class="card border-0 shadow-sm rounded-4 h-100">

                                    <div class="card-body">

                                        <!-- HEADER -->
                                        <div class="d-flex justify-content-between align-items-start">

                                            <div>
                                                <h5 class="fw-bold mb-1">
                                                    <%= app.userId.name %>
                                                </h5>

                                                <p class="text-muted mb-0 small">
                                                    <%= app.userId.email %>
                                                </p>
                                            </div>

                                            <!-- STATUS -->
                                            <span class="
                  badge px-3 py-2 rounded-pill
                  <%= app.status === 'accepted' ? 'bg-success' :
                      app.status === 'rejected' ? 'bg-danger' :
                      app.status === 'reviewed' ? 'bg-info' :
                      'bg-warning text-dark' %>
                ">
                                                <%= app.status %>
                                            </span>

                                        </div>

                                        <hr>

                                        <!-- DETAILS -->
                                        <div class="small text-muted mb-3">

                                            <div class="mb-1">
                                                <i class="bi bi-telephone me-1"></i>
                                                <%= app.number || 'No phone provided' %>
                                            </div>

                                            <div>
                                                <i class="bi bi-calendar me-1"></i>
                                                Applied on <%= new Date(app.createdAt).toLocaleDateString() %>
                                            </div>

                                        </div>

                                        <!-- ACTIONS -->
                                        <div class="d-flex flex-wrap gap-2">

                                            <% if (app.resumeUrl) { %>
                                                <a href="<%= app.resumeUrl %>" target="_blank"
                                                    class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-file-earmark-text"></i>
                                                    Resume
                                                </a>
                                                <% } %>


                                                    <a href="/profile/<%= app.userId.publicId %>"
                                                        class="btn btn-sm btn-outline-primary">
                                                        View User Profile
                                                    </a>


                                                    <a href="/applications/<%= app._id %>"
                                                        class="btn btn-sm btn-outline-primary">
                                                        View Application Details
                                                    </a>

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <% }) %>

                    </div>

                    <% } %>

        </div>

        <%- include('../partials/footer') %>