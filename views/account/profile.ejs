<%- include('../partials/header', { title: 'Profile' }) %>
<%- include('../partials/navbar') %>

<main class="container py-4">
  <div class="row g-4">

    <!-- ── LEFT ── -->
    <div class="col-lg-8">

      <!-- header card -->
      <div class="card shadow-sm border-0">
        <div class="bg-primary rounded-top" style="height:130px"></div>
        <div class="card-body position-relative pb-4">

          <!-- avatar -->
          <div class="position-absolute" style="top:-44px">
            <div class="rounded-circle bg-dark text-white d-flex align-items-center
                        justify-content-center border border-4 border-white shadow"
                 style="width:88px;height:88px;font-size:32px;font-weight:600">
              <%= user.name.charAt(0).toUpperCase() %>
            </div>
          </div>

          <div class="d-flex justify-content-end mb-2">
            <button class="btn btn-outline-primary btn-sm" onclick="openModal('profileModal')">
              <i class="bi bi-pencil me-1"></i>Edit Profile
            </button>
          </div>

          <h4 class="fw-bold mb-1 mt-2"><%= user.name %></h4>
          <p class="text-muted mb-1"><%= profile.headline || 'Add a headline' %></p>
          <p class="text-muted small mb-2">
            <% if (profile.location) { %>
              <i class="bi bi-geo-alt me-1"></i><%= profile.location %>
            <% } %>
            <% if (profile.website) { %>
              <span class="mx-1">·</span>
              <a href="<%= profile.website %>" target="_blank" class="text-decoration-none">
                <i class="bi bi-link-45deg me-1"></i><%= profile.website %>
              </a>
            <% } %>
            <% if (publicId) { %>
              <span class="mx-1"></span>
              <span class="text-muted">Public ID: <%= publicId %></span>
            <% } %>
          </p>

        </div>
      </div>

      <!-- about -->
      <div class="card shadow-sm border-0 mt-3">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="fw-bold mb-0">About</h5>
            <!-- <button class="btn btn-sm btn-outline-secondary" onclick="openModal('profileModal')">
              <i class="bi bi-pencil"></i>
            </button> -->
          </div>
          <p class="text-muted mb-0">
            <%= profile.bio || 'Add a bio to tell people about yourself.' %>
          </p>
        </div>
      </div>

      <!-- experience -->
      <div class="card shadow-sm border-0 mt-3">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Experience</h5>
            <button class="btn btn-sm btn-outline-secondary"
              onclick="openModal('expModal')">
              <i class="bi bi-plus-lg me-1"></i>Add
            </button>
          </div>

          <div id="expList">
            <% if (!experience.length) { %>
              <p class="text-muted small" id="expEmpty">No experience added yet.</p>
            <% } %>
            <% experience.forEach(exp => { %>
              <div class="border rounded-3 p-3 mb-3 exp-item" id="exp-<%= exp._id %>">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <h6 class="fw-bold mb-1"><%= exp.title %></h6>
                    <p class="text-muted mb-1 small">
                      <i class="bi bi-building me-1"></i><%= exp.company %>
                      <% if (exp.location) { %>· <%= exp.location %><% } %>
                    </p>
                    <small class="text-muted">
                      <%= exp.startDate %> — <%= exp.isCurrent ? 'Present' : (exp.endDate || '') %>
                    </small>
                    <% if (exp.description) { %>
                      <p class="mt-2 text-muted small mb-0"><%= exp.description %></p>
                    <% } %>
                  </div>
                  <div class="d-flex gap-2 ms-2 flex-shrink-0">
                    <button class="btn btn-sm btn-outline-secondary"
                      onclick="editExp('<%= exp._id %>','<%= exp.title %>','<%= exp.company %>',
                        '<%= exp.location %>','<%= exp.startDate %>','<%= exp.endDate %>',
                        '<%= exp.isCurrent %>','<%= exp.description %>')">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                      onclick="deleteItem('experience','<%= exp._id %>')">
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- education -->
      <div class="card shadow-sm border-0 mt-3">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Education</h5>
            <button class="btn btn-sm btn-outline-secondary"
              onclick="openModal('eduModal')">
              <i class="bi bi-plus-lg me-1"></i>Add
            </button>
          </div>

          <div id="eduList">
            <% if (!education.length) { %>
              <p class="text-muted small" id="eduEmpty">No education added yet.</p>
            <% } %>
            <% education.forEach(edu => { %>
              <div class="border rounded-3 p-3 mb-3 edu-item" id="edu-<%= edu._id %>">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <h6 class="fw-bold mb-1"><%= edu.school %></h6>
                    <p class="text-muted mb-1 small"><%= edu.degree %>
                      <% if (edu.field) { %> · <%= edu.field %><% } %>
                    </p>
                    <small class="text-muted">
                      <%= edu.startYear %><% if (edu.endYear) { %> — <%= edu.endYear %><% } %>
                    </small>
                    <% if (edu.grade) { %>
                      <small class="text-muted d-block">Grade: <%= edu.grade %></small>
                    <% } %>
                  </div>
                  <div class="d-flex gap-2 ms-2 flex-shrink-0">
                    <button class="btn btn-sm btn-outline-secondary"
                      onclick="editEdu('<%= edu._id %>','<%= edu.school %>','<%= edu.degree %>',
                        '<%= edu.field %>','<%= edu.startYear %>','<%= edu.endYear %>','<%= edu.grade %>')">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                      onclick="deleteItem('education','<%= edu._id %>')">
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

    </div>

    <!-- ── RIGHT ── -->
    <div class="col-lg-4">

      <!-- skills -->
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Skills</h5>
          </div>
          <div class="d-flex flex-wrap gap-2" id="skillsList">
            <% if (profile.skills && profile.skills.length) { %>
              <% profile.skills.forEach(skill => { %>
                <span class="badge bg-light text-dark border"><%= skill %></span>
              <% }) %>
            <% } else { %>
              <p class="text-muted small mb-0">No skills added yet.</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- jobs -->
      <div class="card shadow-sm border-0 mt-3">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Personal Projects or others.</h5>
            <button class="btn btn-sm btn-outline-secondary"
              onclick="openModal('jobModal')">
              <i class="bi bi-plus-lg me-1"></i>Add
            </button>
          </div>

          <div id="jobList">
            <% if (!jobs.length) { %>
              <p class="text-muted small" id="jobEmpty">No projects added yet.</p>
            <% } %>
            <% jobs.forEach(job => { %>
              <div class="border rounded-3 p-3 mb-3 job-item" id="job-<%= job._id %>">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <h6 class="fw-bold mb-1"><%= job.title %></h6>
                    <p class="text-muted mb-1 small">
                      <i class="bi bi-building me-1"></i><%= job.company %>
                    </p>
                    <span class="badge bg-primary bg-opacity-10 text-primary small">
                      <%= job.type %>
                    </span>
                    <% if (job.isCurrent) { %>
                      <span class="badge bg-success bg-opacity-10 text-success small ms-1">
                        Current
                      </span>
                    <% } %>
                    <small class="text-muted d-block mt-1">
                      <%= job.startDate %> — <%= job.isCurrent ? 'Present' : (job.endDate || '') %>
                    </small>
                  </div>
                  <div class="d-flex gap-2 ms-2 flex-shrink-0">
                    <button class="btn btn-sm btn-outline-secondary"
                      onclick="editJob('<%= job._id %>','<%= job.title %>','<%= job.company %>',
                        '<%= job.location %>','<%= job.type %>','<%= job.startDate %>',
                        '<%= job.endDate %>','<%= job.isCurrent %>','<%= job.description %>')">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                      onclick="deleteItem('jobs','<%= job._id %>')">
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

    </div>
  </div>
</main>


<!-- ── PROFILE MODAL ── -->
<div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-person me-2"></i>Edit Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="profileModalError" class="alert alert-danger d-none"></div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Headline</label>
            <input id="p_headline" type="text" class="form-control"
              value="<%= profile.headline || '' %>"
              placeholder="e.g. Full Stack Developer" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Location</label>
            <input id="p_location" type="text" class="form-control"
              value="<%= profile.location || '' %>"
              placeholder="e.g. Toronto, Canada" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Website</label>
            <input id="p_website" type="url" class="form-control"
              value="<%= profile.website || '' %>"
              placeholder="https://yoursite.com" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Phone</label>
            <input id="p_phone" type="tel" class="form-control"
              value="<%= profile.phone || '' %>"
              placeholder="+1 234 567 8900" />
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold">Bio</label>
            <textarea id="p_bio" class="form-control" rows="4"
              placeholder="Tell people about yourself…"><%= profile.bio || '' %></textarea>
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold">Skills</label>
            <input id="p_skills" type="text" class="form-control"
              value="<%= (profile.skills || []).join(', ') %>"
              placeholder="Node.js, React, MongoDB (comma separated)" />
            <div class="form-text">Separate skills with commas</div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" onclick="saveProfile()">
          <span id="profileSaveText">Save Changes</span>
          <span id="profileSaveSpinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
        </button>
      </div>
    </div>
  </div>
</div>


<!-- ── EXPERIENCE MODAL ── -->
<div class="modal fade" id="expModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="expModalTitle">
          <i class="bi bi-briefcase me-2"></i>Add Experience
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="exp_id" />
        <div id="expModalError" class="alert alert-danger d-none"></div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Job Title *</label>
            <input id="exp_title" type="text" class="form-control" placeholder="e.g. Backend Developer" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Company *</label>
            <input id="exp_company" type="text" class="form-control" placeholder="e.g. Google" />
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold">Location</label>
            <input id="exp_location" type="text" class="form-control" placeholder="e.g. Remote" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Start Date *</label>
            <input id="exp_startDate" type="month" class="form-control" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">End Date</label>
