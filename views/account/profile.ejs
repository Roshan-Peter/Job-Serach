          <div class="col-12">
            <label class="form-label fw-semibold">Description</label>
            <textarea id="exp_description" class="form-control" rows="3"
              placeholder="Describe your role…"></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" onclick="saveExp()">
          <span id="expSaveText">Save</span>
          <span id="expSaveSpinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
        </button>
      </div>
    </div>
  </div>
</div>


<!-- ── EDUCATION MODAL ── -->
<div class="modal fade" id="eduModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="eduModalTitle">
          <i class="bi bi-mortarboard me-2"></i>Add Education
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="edu_id" />
        <div id="eduModalError" class="alert alert-danger d-none"></div>
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label fw-semibold">School *</label>
            <input id="edu_school" type="text" class="form-control" placeholder="e.g. MIT" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Degree *</label>
            <input id="edu_degree" type="text" class="form-control" placeholder="e.g. Bachelor's" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Field of Study</label>
            <input id="edu_field" type="text" class="form-control" placeholder="e.g. Computer Science" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Start Year</label>
            <input id="edu_startYear" type="number" class="form-control"
