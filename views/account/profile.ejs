            <input id="edu_grade" type="text" class="form-control" placeholder="e.g. 3.8 / 4.0" />
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" onclick="saveEdu()">
          <span id="eduSaveText">Save</span>
          <span id="eduSaveSpinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
        </button>
      </div>
    </div>
  </div>
</div>


<!-- ── JOB MODAL ── -->
<div class="modal fade" id="jobModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="jobModalTitle">
          <i class="bi bi-person-workspace me-2"></i>Add Job
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="job_id" />
        <div id="jobModalError" class="alert alert-danger d-none"></div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Job Title *</label>
            <input id="job_title" type="text" class="form-control" placeholder="e.g. Software Engineer" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Company *</label>
            <input id="job_company" type="text" class="form-control" placeholder="e.g. Apple" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Location</label>
            <input id="job_location" type="text" class="form-control" placeholder="e.g. Remote" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Type</label>
            <select id="job_type" class="form-select">
              <option>Full-time</option>
              <option>Part-time</option>
              <option>Contract</option>
              <option>Freelance</option>
              <option>Internship</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Start Date *</label>
            <input id="job_startDate" type="month" class="form-control" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">End Date</label>
            <input id="job_endDate" type="month" class="form-control" />
          </div>
          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="job_isCurrent"
                onchange="document.getElementById('job_endDate').disabled = this.checked" />
              <label class="form-check-label" for="job_isCurrent">This is my current job</label>
            </div>
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold">Description</label>
            <textarea id="job_description" class="form-control" rows="3"
              placeholder="Describe your responsibilities…"></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-primary" onclick="saveJob()">
          <span id="jobSaveText">Save</span>
          <span id="jobSaveSpinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
        </button>
      </div>
    </div>
  </div>
</div>


<script>
  // ── helpers ────────────────────────────────────────────────────────────────
  function openModal(id) {
    new bootstrap.Modal(document.getElementById(id)).show();
  }

  function closeModal(id) {
    bootstrap.Modal.getInstance(document.getElementById(id))?.hide();
  }

  function setLoading(textEl, spinnerEl, loading) {
    document.getElementById(textEl).textContent  = loading ? 'Saving…' : 'Save';
    document.getElementById(spinnerEl).classList.toggle('d-none', !loading);
  }

  function showModalError(elId, msg) {
    const el = document.getElementById(elId);
    el.textContent = msg;
    el.classList.remove('d-none');
  }

  async function apiFetch(url, method, body) {
    const res  = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body:    JSON.stringify(body),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Request failed');
    return data;
  }

  // ── profile ────────────────────────────────────────────────────────────────
  async function saveProfile() {
    const errEl = document.getElementById('profileModalError');
    errEl.classList.add('d-none');

    const body = {
      headline: document.getElementById('p_headline').value,
      bio:      document.getElementById('p_bio').value,
      location: document.getElementById('p_location').value,
      website:  document.getElementById('p_website').value,
      phone:    document.getElementById('p_phone').value,
      skills:   document.getElementById('p_skills').value,
    };

    document.getElementById('profileSaveText').textContent = 'Saving…';
    document.getElementById('profileSaveSpinner').classList.remove('d-none');

    try {
      await apiFetch('/profile', 'POST', body);
      closeModal('profileModal');
      window.location.reload();
    } catch (err) {
      showModalError('profileModalError', err.message);
    } finally {
      document.getElementById('profileSaveText').textContent = 'Save Changes';
      document.getElementById('profileSaveSpinner').classList.add('d-none');
    }
  }

  // ── experience ─────────────────────────────────────────────────────────────
  function editExp(id, title, company, location, startDate, endDate, isCurrent, description) {
    document.getElementById('exp_id').value          = id;
    document.getElementById('exp_title').value       = title;
    document.getElementById('exp_company').value     = company;
    document.getElementById('exp_location').value    = location;
    document.getElementById('exp_startDate').value   = startDate;
    document.getElementById('exp_endDate').value     = endDate === 'null' ? '' : endDate;
    document.getElementById('exp_description').value = description === 'undefined' ? '' : description;
    const current = isCurrent === 'true';
    document.getElementById('exp_isCurrent').checked    = current;
    document.getElementById('exp_endDate').disabled      = current;
    document.getElementById('expModalTitle').innerHTML   =
      '<i class="bi bi-briefcase me-2"></i>Edit Experience';
    openModal('expModal');
  }

  async function saveExp() {
    const id  = document.getElementById('exp_id').value;
    const errEl = document.getElementById('expModalError');
    errEl.classList.add('d-none');
    setLoading('expSaveText', 'expSaveSpinner', true);

    const body = {
      title:       document.getElementById('exp_title').value,
      company:     document.getElementById('exp_company').value,
      location:    document.getElementById('exp_location').value,
      startDate:   document.getElementById('exp_startDate').value,
      endDate:     document.getElementById('exp_endDate').value || null,
      isCurrent:   document.getElementById('exp_isCurrent').checked,
      description: document.getElementById('exp_description').value,
    };

    try {
      const url    = id ? `/profile/experience/${id}` : '/profile/experience';
      const method = id ? 'PUT' : 'POST';
      await apiFetch(url, method, body);
      closeModal('expModal');
      window.location.reload();
    } catch (err) {
      showModalError('expModalError', err.message);
    } finally {
      setLoading('expSaveText', 'expSaveSpinner', false);
    }
  }

  // ── education ──────────────────────────────────────────────────────────────
  function editEdu(id, school, degree, field, startYear, endYear, grade) {
    document.getElementById('edu_id').value        = id;
    document.getElementById('edu_school').value    = school;
    document.getElementById('edu_degree').value    = degree;
    document.getElementById('edu_field').value     = field === 'undefined' ? '' : field;
    document.getElementById('edu_startYear').value = startYear;
    document.getElementById('edu_endYear').value   = endYear === 'undefined' ? '' : endYear;
    document.getElementById('edu_grade').value     = grade === 'undefined' ? '' : grade;
    document.getElementById('eduModalTitle').innerHTML =
      '<i class="bi bi-mortarboard me-2"></i>Edit Education';
    openModal('eduModal');
  }

  async function saveEdu() {
    const id    = document.getElementById('edu_id').value;
    const errEl = document.getElementById('eduModalError');
    errEl.classList.add('d-none');
    setLoading('eduSaveText', 'eduSaveSpinner', true);

    const body = {
      school:    document.getElementById('edu_school').value,
      degree:    document.getElementById('edu_degree').value,
      field:     document.getElementById('edu_field').value,
      startYear: document.getElementById('edu_startYear').value,
      endYear:   document.getElementById('edu_endYear').value,
      grade:     document.getElementById('edu_grade').value,
    };

    try {
      const url    = id ? `/profile/education/${id}` : '/profile/education';
      const method = id ? 'PUT' : 'POST';
      await apiFetch(url, method, body);
      closeModal('eduModal');
      window.location.reload();
    } catch (err) {
      showModalError('eduModalError', err.message);
    } finally {
      setLoading('eduSaveText', 'eduSaveSpinner', false);
    }
  }

  // ── jobs ───────────────────────────────────────────────────────────────────
  function editJob(id, title, company, location, type, startDate, endDate, isCurrent, description) {
    document.getElementById('job_id').value          = id;
    document.getElementById('job_title').value       = title;
    document.getElementById('job_company').value     = company;
    document.getElementById('job_location').value    = location === 'undefined' ? '' : location;
    document.getElementById('job_type').value        = type;
    document.getElementById('job_startDate').value   = startDate;
    document.getElementById('job_endDate').value     = endDate === 'null' ? '' : endDate;
    document.getElementById('job_description').value = description === 'undefined' ? '' : description;
    const current = isCurrent === 'true';
    document.getElementById('job_isCurrent').checked  = current;
    document.getElementById('job_endDate').disabled    = current;
    document.getElementById('jobModalTitle').innerHTML =
      '<i class="bi bi-person-workspace me-2"></i>Edit Job';
    openModal('jobModal');
  }

  async function saveJob() {
    const id    = document.getElementById('job_id').value;
    const errEl = document.getElementById('jobModalError');
    errEl.classList.add('d-none');
    setLoading('jobSaveText', 'jobSaveSpinner', true);

    const body = {
      title:       document.getElementById('job_title').value,
      company:     document.getElementById('job_company').value,
      location:    document.getElementById('job_location').value,
      type:        document.getElementById('job_type').value,
      startDate:   document.getElementById('job_startDate').value,
      endDate:     document.getElementById('job_endDate').value || null,
      isCurrent:   document.getElementById('job_isCurrent').checked,
      description: document.getElementById('job_description').value,
    };

    try {
      const url    = id ? `/profile/jobs/${id}` : '/profile/jobs';
      const method = id ? 'PUT' : 'POST';
      await apiFetch(url, method, body);
      closeModal('jobModal');
      window.location.reload();
    } catch (err) {
      showModalError('jobModalError', err.message);
    } finally {
      setLoading('jobSaveText', 'jobSaveSpinner', false);
    }
  }

  // ── delete ─────────────────────────────────────────────────────────────────
  async function deleteItem(type, id) {
    if (!confirm('Are you sure you want to delete this?')) return;
    try {
      await apiFetch(`/profile/${type}/${id}`, 'DELETE', {});
      document.getElementById(`${type.slice(0,-1)}-${id}`)?.remove();
    } catch (err) {
      alert(err.message || 'Failed to delete');
    }
  }

  // ── reset modals on close ──────────────────────────────────────────────────
  document.getElementById('expModal').addEventListener('hidden.bs.modal', () => {
    document.getElementById('exp_id').value = '';
    document.getElementById('expModalTitle').innerHTML =
      '<i class="bi bi-briefcase me-2"></i>Add Experience';
    document.getElementById('expModalError').classList.add('d-none');
  });

  document.getElementById('eduModal').addEventListener('hidden.bs.modal', () => {
    document.getElementById('edu_id').value = '';
    document.getElementById('eduModalTitle').innerHTML =
      '<i class="bi bi-mortarboard me-2"></i>Add Education';
    document.getElementById('eduModalError').classList.add('d-none');
  });

  document.getElementById('jobModal').addEventListener('hidden.bs.modal', () => {
    document.getElementById('job_id').value = '';
    document.getElementById('jobModalTitle').innerHTML =
      '<i class="bi bi-person-workspace me-2"></i>Add Job';
    document.getElementById('jobModalError').classList.add('d-none');
  });
</script>

