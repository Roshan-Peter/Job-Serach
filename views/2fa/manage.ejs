<%- include('../partials/header', { title: 'Manage 2FA' }) %>
<%- include('../partials/navbar') %>

<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-5">

      <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/account-settings" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="fw-bold mb-0">Two-Factor Authentication</h2>
      </div>

      <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show">
          <i class="bi bi-check-circle me-2"></i><%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show" id="pageError">
          <i class="bi bi-exclamation-circle me-2"></i><%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

          <div class="d-flex align-items-center gap-3 mb-4">
            <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center"
              style="width:56px;height:56px;flex-shrink:0">
              <i class="bi bi-shield-check text-success fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0">2FA is Enabled</h5>
              <p class="text-muted small mb-0">
                Your account is protected with an authenticator app.
              </p>
            </div>
          </div>

          <hr/>

          <h6 class="fw-bold text-danger mb-2">Disable 2FA</h6>
          <p class="text-muted small mb-3">
            Enter your current authenticator code to confirm. This will remove 2FA protection from your account.
          </p>

          <div id="disableError" class="alert alert-danger d-none"></div>

          <form id="disableForm">
            <div class="mb-3">
              <label class="form-label fw-semibold">Authenticator Code</label>
              <input id="disableToken" type="text" class="form-control text-center fw-bold ls-4"
                placeholder="_ _ _ _ _ _"
                maxlength="6"
                inputmode="numeric"
                autocomplete="one-time-code"
                required />
            </div>
            <button id="disableBtn" type="submit" class="btn btn-outline-danger w-100">
              <span id="disableBtnText">
                <i class="bi bi-shield-x me-2"></i>Disable Two-Factor Authentication
              </span>
              <span id="disableSpinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</main>

<script>
  document.getElementById('disableToken').addEventListener('input', e => {
    e.target.value = e.target.value.replace(/\D/g, '');
  });

  document.getElementById('disableForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const token   = document.getElementById('disableToken').value.trim();
    const errEl   = document.getElementById('disableError');
    const btn     = document.getElementById('disableBtn');
    const btnText = document.getElementById('disableBtnText');
    const spinner = document.getElementById('disableSpinner');

    errEl.classList.add('d-none');
    btn.disabled = true;
    btnText.innerHTML = 'Disabling…';
    spinner.classList.remove('d-none');

    try {
      const res  = await fetch('/account/2fa/disable', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body:    JSON.stringify({ token }),
      });
      const data = await res.json();
      if (!res.ok) {
        errEl.textContent = data.error || 'Failed to disable 2FA';
        errEl.classList.remove('d-none');
      } else {
        window.location.href = '/account-settings';
      }
    } catch {
      errEl.textContent = 'Network error. Please try again.';
      errEl.classList.remove('d-none');
    } finally {
      btn.disabled = false;
      btnText.innerHTML = '<i class="bi bi-shield-x me-2"></i>Disable Two-Factor Authentication';
      spinner.classList.add('d-none');
    }
  });
</script>

<%- include('../partials/footer') %>