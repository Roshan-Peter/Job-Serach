<%- include('../partials/header') %>
<%- include('../partials/navbar') %>



<style>
  /* ── screen wrapper ── */
  .page-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 24px 16px 48px;
  }

  /* ── A4 page ── */
  .a4-page {
    width: 210mm;
    min-height: 297mm;
    background: #ffffff;
    box-shadow: 0 4px 24px rgba(0,0,0,0.15);
    box-sizing: border-box;
    padding: 16mm 18mm;
    font-family: 'Times New Roman', Times, serif;
    font-size: 10.5pt;
    line-height: 1.45;
    color: #111111;
    position: relative;
  }

  /* ── ATS: all text black, no background colors ── */
  .resume-name {
    font-size: 22pt;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin: 0 0 2px;
    color: #000;
    text-align: center;
  }

  .resume-headline {
    font-size: 10.5pt;
    color: #333;
    text-align: center;
    margin: 0 0 6px;
  }

  .contact-bar {
    text-align: center;
    font-size: 9.5pt;
    color: #222;
    margin-bottom: 10px;
    border-bottom: 1.5pt solid #000;
    padding-bottom: 8px;
  }

  .contact-bar span + span::before {
    content: ' | ';
    color: #555;
  }

  /* ── section headings ── */
  .section {
    margin-bottom: 10px;
  }

  .section-heading {
    font-size: 11pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-bottom: 1pt solid #000;
    padding-bottom: 2px;
    margin: 0 0 6px;
    color: #000;
  }

  /* ── experience / education items ── */
  .item {
    margin-bottom: 8px;
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }

  .item-title {
    font-weight: 700;
    font-size: 10.5pt;
    color: #000;
    margin: 0;
  }

  .item-date {
    font-size: 9.5pt;
    color: #333;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .item-sub {
    font-size: 10pt;
    color: #333;
    font-style: italic;
    margin: 1px 0 3px;
  }

  .item-desc {
    font-size: 10pt;
    color: #222;
    margin: 0;
    padding-left: 12px;
  }

  .item-desc li {
    margin-bottom: 2px;
  }

  /* ── skills ── */
  .skills-list {
    font-size: 10pt;
    color: #111;
    margin: 0;
  }

  /* ── summary ── */
  .summary-text {
    font-size: 10.5pt;
    color: #111;
    margin: 0;
    text-align: justify;
  }

  /* ── two-column layout for sidebar sections ── */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
  }

  /* ── page break control ── */
  .no-break {
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .page-break {
    break-after: page;
    page-break-after: always;
  }

  /* ── print styles ── */
  @media print {
    @page {
      size: A4;
      margin: 0;
    }

    html, body {
      margin: 0;
      padding: 0;
    }

    .no-print {
      display: none !important;
    }

    .page-wrapper {

      padding: 0 !important;
      gap: 0 !important;
    }

    .a4-page {
      width: 210mm;
      min-height: 297mm;
      box-shadow: none !important;
      padding: 16mm 18mm;
      margin: 0;
      break-after: page;
      page-break-after: always;
    }

    .a4-page:last-child {
      break-after: avoid;
      page-break-after: avoid;
    }
  }

  /* ── screen only — scale down on small screens ── */
  @media screen and (max-width: 240mm) {
    .a4-page {
      width: 100%;
      min-height: auto;
      padding: 8mm 6mm;
    }
  }
</style>

<div class="page-wrapper" id="resumePages">

  <!-- ══ PAGE 1 ══ -->
  <div class="a4-page">

    <!-- header -->
    <h1 class="resume-name"><%= userName %></h1>
    <p class="resume-headline"><%= headline || '' %></p>
    <div class="contact-bar">
      <% if (resume.contact?.phone) { %>
        <span><%= resume.contact.phone %></span>
      <% } %>
      <% if (resume.contact?.email) { %>
        <span><%= resume.contact.email %></span>
      <% } %>
      <% if (resume.contact?.website) { %>
        <span><%= resume.contact.website %></span>
      <% } %>
      <% if (resume.contact?.location) { %>
        <span><%= resume.contact.location %></span>
      <% } %>
    </div>

    <!-- summary -->
    <% if (resume.summary) { %>
      <div class="section no-break">
        <p class="section-heading">Professional Summary</p>
        <p class="summary-text"><%= resume.summary %></p>
      </div>
    <% } %>

    <!-- experience -->
    <% if (resume.experience && resume.experience.length) { %>
      <div class="section">
        <p class="section-heading">Work Experience</p>
        <% resume.experience.forEach(exp => { %>
          <div class="item no-break">
            <div class="item-header">
              <p class="item-title"><%= exp.role %></p>
              <span class="item-date">
                <%= exp.startDate %><% if (exp.endDate) { %> – <%= exp.endDate %><% } else { %> – Present<% } %>
              </span>
            </div>
            <p class="item-sub"><%= exp.company %></p>
            <% if (exp.description) { %>
              <ul class="item-desc">
                <% exp.description.split('\n').filter(l => l.trim()).forEach(line => { %>
                  <li><%= line.trim() %></li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- education -->
    <% if (resume.education && resume.education.length) { %>
      <div class="section">
        <p class="section-heading">Education</p>
        <% resume.education.forEach(edu => { %>
          <div class="item no-break">
            <div class="item-header">
              <p class="item-title"><%= edu.degree %></p>
              <span class="item-date"><%= edu.year || '' %></span>
            </div>
            <p class="item-sub"><%= edu.institution %></p>
            <% if (edu.grade) { %>
              <p style="font-size:10pt; margin:0; color:#333">GPA / Grade: <%= edu.grade %></p>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- skills -->
    <% if (resume.skills && resume.skills.length) { %>
      <div class="section no-break">
        <p class="section-heading">Skills</p>
        <p class="skills-list"><%= resume.skills.join(' · ') %></p>
      </div>
    <% } %>

    <!-- certifications -->
    <% if (resume.certifications && resume.certifications.length) { %>
      <div class="section">
        <p class="section-heading">Certifications</p>
        <% resume.certifications.forEach(cert => { %>
          <div class="item no-break">
            <div class="item-header">
              <p class="item-title"><%= cert.name %></p>
              <span class="item-date"><%= cert.year || '' %></span>
            </div>
            <p class="item-sub"><%= cert.issuer %></p>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- languages -->
    <% if (resume.languages && resume.languages.length) { %>
      <div class="section no-break">
        <p class="section-heading">Languages</p>
        <p class="skills-list"><%= resume.languages.map(l => `${l.name} (${l.level})`).join(' · ') %></p>
      </div>
    <% } %>

  </div>
  <!-- ══ END PAGE 1 ══ -->

  <!--
    If you have a second page of content (e.g. projects, publications)
    add a second .a4-page block here. The print CSS will break it correctly.

    <div class="a4-page">
      ... additional content ...
    </div>
  -->

</div>


<div class="no-print d-flex justify-content-center gap-2 py-3">
 <button class="btn btn-primary btn-sm" onclick="printResume()">
  <i class="bi bi-printer me-1"></i>Print / Save as PDF
</button>
  
</div>

<script>
  // auto-detect overflow and warn on screen
  window.addEventListener('load', () => {
    document.querySelectorAll('.a4-page').forEach((page, i) => {
      const mmToPx = 3.7795;
      const maxH   = 297 * mmToPx;
      if (page.scrollHeight > maxH + 10) {
        console.warn(`Page ${i + 1} overflows A4 height. Consider splitting content.`);
      }
    });
  });
</script>






<script>
  function printResume() {
    const resumeHtml = document.getElementById('resumePages').innerHTML;

    const win = window.open('', '_blank', 'width=900,height=700');
    win.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <meta charset="utf-8"/>
        <title><%= userName %> — Resume</title>
        <style>
          * { margin: 0; padding: 0; box-sizing: border-box; }

          @page {
            size: A4;
            margin: 0;
          }

          html, body {
            background: #fff;
            font-family: 'Times New Roman', Times, serif;
            font-size: 10.5pt;
            color: #111;
          }

          .a4-page {
            width: 210mm;
            min-height: 297mm;
            padding: 16mm 18mm;
            background: #fff;
            break-after: page;
            page-break-after: always;
          }

          .a4-page:last-child {
            break-after: avoid;
            page-break-after: avoid;
          }

          /* paste all your resume CSS here */
          .resume-name { font-size: 22pt; font-weight: 700; letter-spacing: 0.5px; margin: 0 0 2px; color: #000; text-align: center; }
          .resume-headline { font-size: 10.5pt; color: #333; text-align: center; margin: 0 0 6px; }
          .contact-bar { text-align: center; font-size: 9.5pt; color: #222; margin-bottom: 10px; border-bottom: 1.5pt solid #000; padding-bottom: 8px; }
          .contact-bar span + span::before { content: ' | '; color: #555; }
          .section { margin-bottom: 10px; }
          .section-heading { font-size: 11pt; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1pt solid #000; padding-bottom: 2px; margin: 0 0 6px; color: #000; }
          .item { margin-bottom: 8px; }
          .item-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
          .item-title { font-weight: 700; font-size: 10.5pt; color: #000; margin: 0; }
          .item-date { font-size: 9.5pt; color: #333; white-space: nowrap; flex-shrink: 0; }
          .item-sub { font-size: 10pt; color: #333; font-style: italic; margin: 1px 0 3px; }
          .item-desc { font-size: 10pt; color: #222; margin: 0; padding-left: 16px; }
          .item-desc li { margin-bottom: 2px; }
          .skills-list { font-size: 10pt; color: #111; margin: 0; }
          .summary-text { font-size: 10.5pt; color: #111; margin: 0; text-align: justify; }
          .no-break { break-inside: avoid; page-break-inside: avoid; }
          .page-wrapper { background: #fff; }

          /* ✅ this is the key — hide everything the browser adds */
          @media print {
            @page { size: A4; margin: 0; }
            html, body { margin: 0; padding: 0; }
          }
        </style>
      </head>
      <body>
        <div class="page-wrapper">
          ${resumeHtml}
        </div>
        <script>
          window.onload = function() {
            window.print();
            window.onafterprint = function() { window.close(); };
          };
        <\/script>
      </body>
      </html>
    `);
    win.document.close();
  }
</script>

<%- include('../partials/footer') %>