<%- include('partials/header', { title: 'Dashboard' }) %>
<%- include('partials/navbar') %>

<main class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-0">Welcome back, <%= user.name %> 👋</h2>
      <p class="text-muted small mb-0"><%= user.email %></p>
    </div>
    <div class="d-flex gap-2">
      <!-- ✅ Post a job button -->
      <a href="/jobs/create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Post a Job
      </a>
    </div>
  </div>

  <!-- stats cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <h6 class="text-muted small">STATUS</h6>
          <p class="mb-0 fw-semibold text-success">
            <i class="bi bi-check-circle me-1"></i>Email Confirmed
          </p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <h6 class="text-muted small">SESSION</h6>
          <p class="mb-0 fw-semibold">
            <i class="bi bi-shield-check me-1 text-primary"></i>Active
          </p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <a href="/jobs" class="card shadow-sm border-0 text-decoration-none">
        <div class="card-body">
          <h6 class="text-muted small">JOBS</h6>
          <p class="mb-0 fw-semibold text-primary">
            <i class="bi bi-briefcase me-1"></i>Browse listings
          </p>
        </div>
      </a>
    </div>
  </div>


  <!-- VIEW APPLICATIONS CARD -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">

  <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">

    <div class="d-flex align-items-center gap-3">


      <!-- TEXT -->
      <div>
        <h5 class="fw-bold mb-1">View My Applications</h5>

        <p class="text-muted mb-0">
          Track jobs you've applied for and monitor application status.
        </p>
      </div>

    </div>
    

    <!-- BUTTON -->
    <button
      class="btn btn-primary px-4 rounded-pill"
      data-bs-toggle="modal"
      data-bs-target="#applicationsModal"
    >
      <i class="bi bi-eye-fill me-2"></i>
      View Applications
    </button>

  </div>

</div>


<div class="card border-0 shadow-sm rounded-4 overflow-hidden">

  <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">

    <div class="d-flex align-items-center gap-3">


      <!-- TEXT -->
      <div>
        <h5 class="fw-bold mb-1">Create Resume</h5>

        <p class="text-muted mb-0">
          Create your new resume with Job Search
        </p>
      </div>

    </div>
    

    <!-- BUTTON -->
    <a
          class="btn btn-primary px-4 rounded-pill"
      href="/resumes"
    >
      <i class="bi bi-eye-fill me-2"></i>
      Create
  </a>

  </div>

</div>


  <!-- recent login activity -->
  <div class="card shadow-sm mt-5 border-0">
    <div class="card-header  fw-semibold">
      <i class="bi bi-clock-history me-2 text-primary"></i>Recent Login Activity
    </div>
    <ul class="list-group list-group-flush">
      <% if (typeof loginLogs !== 'undefined' && loginLogs.length) { %>
        <% loginLogs.forEach(log => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center py-3">
            <div>
              <span class="badge <%= log.status === 'success' ? 'bg-success' : 'bg-danger' %> me-2">
                <%= log.status %>
              </span>
              <small class="text-muted"><%= log.ip %></small>
              <% if (log.reason) { %>
                <small class="text-danger ms-2">— <%= log.reason %></small>
              <% } %>
            </div>
            <small class="text-muted"><%= log.createdAt.toLocaleString() %></small>
          </li>
        <% }) %>
      <% } else { %>
        <li class="list-group-item text-muted small text-center py-3">No login activity yet</li>
      <% } %>
    </ul>
  </div>
</main>








<!-- APPLICATIONS MODAL -->
<div class="modal fade" id="applicationsModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">

      <div class="modal-header border-0">
        <h4 class="fw-bold">My Applications</h4>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <!-- LOADER -->
        <div id="appLoader" class="text-center py-5">
          <div class="spinner-border text-primary" role="status"></div>
          <p class="text-muted mt-3">Loading your applications...</p>
        </div>

        <!-- CONTAINER -->
        <div id="appContainer" class="d-none d-flex flex-column gap-3"></div>

        <!-- EMPTY STATE -->
        <div id="appEmpty" class="text-center py-5 d-none">
          <h5 class="text-muted">No applications found</h5>
        </div>

      </div>

    </div>
  </div>
</div>



<script>
document.addEventListener("DOMContentLoaded", () => {

  const modal = document.getElementById("applicationsModal");
  const loader = document.getElementById("appLoader");
  const container = document.getElementById("appContainer");
  const empty = document.getElementById("appEmpty");

  async function loadApplications() {

    // reset UI
    loader.classList.remove("d-none");
    container.classList.add("d-none");
    empty.classList.add("d-none");

    container.innerHTML = "";

    try {

      const res = await fetch("/applications/me");
      const data = await res.json();

      if (!res.ok) throw new Error(data.error);

      const applications = data.applications;

      loader.classList.add("d-none");

      if (!applications.length) {
        empty.classList.remove("d-none");
        return;
      }

      container.classList.remove("d-none");

      applications.forEach(app => {

        const statusColor =
          app.status === "accepted" ? "success" :
          app.status === "rejected" ? "danger" :
          app.status === "reviewed" ? "info" : "warning";

        container.innerHTML += `
          <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">

              <div>
                <h5 class="fw-bold mb-1">${app.jobId?.title || "Job"}</h5>
                <p class="text-muted mb-1">${app.jobId?.company || ""}</p>
                <small class="text-muted">
                  Applied on ${new Date(app.createdAt).toLocaleDateString()}
                </small>
              </div>

              <span class="badge bg-${statusColor} px-3 py-2 rounded-pill">
                ${app.status}
              </span>

            </div>
          </div>
        `;

      });

    } catch (err) {
      loader.classList.add("d-none");
      empty.classList.remove("d-none");
      empty.innerHTML = `<h5 class="text-danger">${err.message}</h5>`;
    }
  }

  // when modal opens → fetch data
  modal.addEventListener("show.bs.modal", loadApplications);

});
</script>


<%- include('partials/footer') %>