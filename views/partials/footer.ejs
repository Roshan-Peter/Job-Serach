<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<style>
  /* stick footer to bottom when content is short */
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  footer {
    flex-shrink: 0;
  }
</style>

<footer class="bg-body-tertiary border-top mt-auto py-4">
  <div class="container">
    <div class="row gy-4 align-items-center">

      <!-- brand -->
      <div class="col-md-4 text-center text-md-start">
        <a href="/" class="text-decoration-none fw-bold fs-5">
          <i class="bi bi-briefcase-fill text-primary me-2"></i>Job Search
        </a>
        <p class="text-muted small mt-1 mb-0">Find your next opportunity.</p>
      </div>

      <!-- links -->
      <div class="col-md-4 text-center">
        <ul class="list-inline mb-0">
          <% if (!user){ %>
            <li class="list-inline-item">
              <a href="/" class="text-muted text-decoration-none small">Home</a>
            </li>

            <li class="list-inline-item text-muted">·</li>

            <li class="list-inline-item">
              <a href="/about" class="text-muted text-decoration-none small">About</a>
            </li>

            <li class="list-inline-item text-muted">·</li>

            <li class="list-inline-item">
              <a href="/contact" class="text-muted text-decoration-none small">Contact</a>
            </li>

            <li class="list-inline-item text-muted">·</li>

            <li class="list-inline-item">
              <a href="/privacy" class="text-muted text-decoration-none small">Privacy</a>
            </li>

            <% } %>
        </ul>
      </div>

      <!-- social + copyright -->
      <div class="col-md-4 text-center text-md-end">
        <div class="d-flex justify-content-center justify-content-md-end gap-3 mb-2">
          <a href="#" class="text-muted fs-5"><i class="bi bi-twitter-x"></i></a>
          <a href="#" class="text-muted fs-5"><i class="bi bi-linkedin"></i></a>
          <a href="#" class="text-muted fs-5"><i class="bi bi-github"></i></a>
          <a href="#" class="text-muted fs-5"><i class="bi bi-instagram"></i></a>
        </div>
        <p class="text-muted small mb-0">
          &copy; <%= new Date().getFullYear() %> Job Search. All rights reserved.
        </p>
      </div>

    </div>
  </div>
</footer>

<% if (user) { %>
  <script src="/socket.io/socket.io.js"></script>

  <script>
    const socket = io();


    // notify activity
    function sendActivity() {
      socket.emit("activity");
    }

    // detect activity
    ["click", "keydown", "mousemove", "scroll"].forEach(event => {
      window.addEventListener(event, sendActivity);
    });

    window.addEventListener("beforeunload", () => {
      socket.disconnect();
    });
  </script>
  <% } %>

    </body>

    </html>