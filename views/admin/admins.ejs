<%- include('../partials/header', { title: 'Manage Admins' }) %>
<%- include('../partials/navbar') %>

<main class="container-fluid py-4 px-4">

  <div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left"></i>
    </a>
    <div>
      <h2 class="fw-bold mb-0">Manage Admins</h2>
      <p class="text-muted small mb-0">Add or remove admin access by user ID</p>
    </div>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="bi bi-exclamation-circle me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle me-2"></i><%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="row g-4">

    <!-- add admin form -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header fw-semibold py-3">
          <i class="bi bi-person-plus me-2 text-primary"></i>Add Admin
        </div>
        <div class="card-body p-4">
          <form action="/admin/admins" method="post">

            <div class="mb-3">
              <label class="form-label fw-semibold">
                Select User <span class="text-danger">*</span>
              </label>
              <!-- searchable select -->
              <select name="userId" class="form-select" required>
                <option value="">Search or select a user…</option>
                <% users.forEach(u => { %>
                  <option value="<%= u._id %>">
                    <%= u.name %> — <%= u.email %>
                  </option>
                <% }) %>
              </select>
              <div class="form-text">User ID is used internally to link the admin record</div>
            </div>

            <div class="mb-4">
              <label class="form-label fw-semibold">Role</label>
              <select name="role" class="form-select">
                <option value="admin">Admin</option>
                <option value="moderator">Moderator</option>
                <option value="super_admin">Super Admin</option>
              </select>
              <div class="form-text mt-2">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Super Admin</strong> — full access + manage admins<br>
                <i class="bi bi-info-circle me-1"></i>
                <strong>Admin</strong> — manage users and jobs<br>
                <i class="bi bi-info-circle me-1"></i>
                <strong>Moderator</strong> — manage jobs only
              </div>
            </div>

            <div class="d-grid">
              <button class="btn btn-primary" type="submit">
                <i class="bi bi-person-plus me-2"></i>Add as Admin
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- current admins table -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header fw-semibold py-3">
          <i class="bi bi-shield-lock me-2 text-danger"></i>
          Current Admins (<%= admins.length %>)
        </div>
        <% if (!admins.length) { %>
          <div class="card-body text-center text-muted py-5">
            <i class="bi bi-shield-x fs-1 d-block mb-3 opacity-25"></i>
            No admins yet. Add one above.
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="small fw-semibold">User</th>
                  <th class="small fw-semibold">User ID</th>
                  <th class="small fw-semibold">Role</th>
                  <th class="small fw-semibold">Added by</th>
                  <th class="small fw-semibold">Added on</th>
                  <th class="small fw-semibold">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% admins.forEach(a => { %>
                  <% const isSelf = String(a.userId._id) === String(user._id); %>
                  <tr>
                    <td>
                      <div class="fw-semibold small"><%= a.userId.name %></div>
                      <div class="text-muted" style="font-size:11px"><%= a.userId.email %></div>
                    </td>
                    <td>
                      <code class="small text-muted" style="font-size:11px">
                        <%= a.userId._id %>
                      </code>
                    </td>
                    <td>
                      <select class="form-select form-select-sm role-select"
                        data-user-id="<%= a.userId._id %>"
                        style="width:130px"
                        <%= isSelf ? 'disabled' : '' %>>
                        <% ['super_admin','admin','moderator'].forEach(r => { %>
                          <option value="<%= r %>" <%= a.role === r ? 'selected' : '' %>><%= r %></option>
                        <% }) %>
                      </select>
                    </td>
                    <td class="small text-muted">
                      <%= a.addedBy ? a.addedBy.name : 'Seeded' %>
                    </td>
                    <td class="small text-muted">
                      <%= new Date(a.createdAt).toLocaleDateString() %>
                    </td>
                    <td>
                      <% if (!isSelf) { %>
                        <form action="/admin/admins/<%= a.userId._id %>/remove" method="post"
                          onsubmit="return confirm('Remove admin access for <%= a.userId.name %>?')">
                          <button class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-person-dash"></i>
                          </button>
                        </form>
                      <% } else { %>
                        <span class="text-muted small">You</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<script>
  // live role update on dropdown change
  document.querySelectorAll('.role-select').forEach(sel => {
    sel.addEventListener('change', async () => {
      const userId = sel.dataset.userId;
      const role   = sel.value;
      const res    = await fetch(`/admin/admins/${userId}/role`, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body:    JSON.stringify({ role }),
      });
      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'Failed to update role');
        sel.value = sel.dataset.original; // revert
      }
    });
    // store original for revert
    sel.dataset.original = sel.value;
  });
</script>

<%- include('../partials/footer') %>