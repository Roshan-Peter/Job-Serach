<%- include('../partials/header', { title: 'Admin Dashboard' }) %>
<%- include('../partials/navbar') %>

<main class="container-fluid py-4 px-4">

  <!-- page header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-0">
        <i class="bi bi-shield-lock-fill text-danger me-2"></i>Admin Dashboard
      </h2>
      <p class="text-muted small mb-0">
        Signed in as <strong><%= user.email %></strong>
        <span class="badge bg-danger ms-2"><%= user.adminRole %></span>
      </p>
    </div>
    <form action="/logout" method="post">
      <button class="btn btn-outline-danger btn-sm">
        <i class="bi bi-box-arrow-right me-1"></i>Logout
      </button>
    </form>
  </div>

  <!-- ── STAT CARDS ── -->
  <div class="row g-3 mb-4">

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
            style="width:56px;height:56px">
            <i class="bi bi-people-fill text-primary fs-4"></i>
          </div>
          <div>
            <div class="fs-2 fw-bold lh-1"><%= stats.totalUsers %></div>
            <div class="text-muted small mt-1">Total Users</div>
          </div>
        </div>
        <a href="/admin/users" class="card-footer text-decoration-none text-muted small bg-transparent border-top py-2">
          View all users <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
            style="width:56px;height:56px">
            <i class="bi bi-briefcase-fill text-success fs-4"></i>
          </div>
          <div>
            <div class="fs-2 fw-bold lh-1"><%= stats.totalJobs %></div>
            <div class="text-muted small mt-1">Total Jobs</div>
          </div>
        </div>
        <a href="/admin/jobs" class="card-footer text-decoration-none text-muted small bg-transparent border-top py-2">
          View all jobs <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <div class="rounded-circle bg-danger bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
            style="width:56px;height:56px">
            <i class="bi bi-shield-lock-fill text-danger fs-4"></i>
          </div>
          <div>
            <div class="fs-2 fw-bold lh-1"><%= stats.totalAdmins %></div>
            <div class="text-muted small mt-1">Total Admins</div>
          </div>
        </div>
        <% if (user.adminRole === 'super_admin') { %>
          <a href="/admin/admins" class="card-footer text-decoration-none text-muted small bg-transparent border-top py-2">
            Manage admins <i class="bi bi-arrow-right ms-1"></i>
          </a>
        <% } else { %>
          <div class="card-footer text-muted small bg-transparent border-top py-2">
            Admin accounts
          </div>
        <% } %>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <div class="rounded-circle bg-warning bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
            style="width:56px;height:56px">
            <i class="bi bi-clock-history text-warning fs-4"></i>
          </div>
          <div>
            <div class="fs-2 fw-bold lh-1"><%= logs.length %></div>
            <div class="text-muted small mt-1">Recent Logins</div>
          </div>
        </div>
        <div class="card-footer text-muted small bg-transparent border-top py-2">
          Last 10 attempts
        </div>
      </div>
    </div>

  </div>

  <!-- ── MAIN CONTENT ── -->
  <div class="row g-4">

    <!-- recent users -->
    <div class="col-xl-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header d-flex justify-content-between align-items-center py-3">
          <span class="fw-semibold">
            <i class="bi bi-people me-2 text-primary"></i>Recent Users
          </span>
          <a href="/admin/users" class="btn btn-outline-primary btn-sm">View all</a>
        </div>
        <% if (!users.length) { %>
          <div class="card-body text-center text-muted py-5">
            <i class="bi bi-people fs-1 d-block mb-3 opacity-25"></i>
            No users yet
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="">
                <tr>
                  <th class="small fw-semibold ps-3">Name</th>
                  <th class="small fw-semibold">Email</th>
                  <th class="small fw-semibold">Status</th>
                  <th class="small fw-semibold">Joined</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(u => { %>
                  <tr>
                    <td class="ps-3">
                      <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold"
                          style="width:34px;height:34px;font-size:13px;flex-shrink:0">
                          <%= u.name.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                          <div class="small fw-semibold"><%= u.name %></div>
                          <% const isAdminUser = admins.some(a => String(a.userId._id) === String(u._id)); %>
                          <% if (isAdminUser) { %>
                            <span class="badge bg-danger" style="font-size:10px">Admin</span>
                          <% } %>
                        </div>
                      </div>
                    </td>
                    <td class="small text-muted"><%= u.email %></td>
                    <td>
                      <span class="badge <%= u.isEmailConfirmed ? 'bg-success' : 'bg-warning text-dark' %>">
                        <%= u.isEmailConfirmed ? 'Confirmed' : 'Pending' %>
                      </span>
                    </td>
                    <td class="small text-muted">
                      <%= new Date(u.createdAt).toLocaleDateString() %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <!-- recent jobs -->
    <div class="col-xl-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header d-flex justify-content-between align-items-center py-3">
          <span class="fw-semibold">
            <i class="bi bi-briefcase me-2 text-success"></i>Recent Jobs
          </span>
          <a href="/admin/jobs" class="btn btn-outline-success btn-sm">View all</a>
        </div>
        <% if (!jobs.length) { %>
          <div class="card-body text-center text-muted py-5">
            <i class="bi bi-briefcase fs-1 d-block mb-3 opacity-25"></i>
            No jobs posted yet
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="">
                <tr>
                  <th class="small fw-semibold ps-3">Title</th>
                  <th class="small fw-semibold">Company</th>
                  <th class="small fw-semibold">Type</th>
                  <th class="small fw-semibold">Apply</th>
                </tr>
              </thead>
              <tbody>
                <% jobs.forEach(j => { %>
                  <tr>
                    <td class="ps-3">
                      <a href="/jobs/<%= j._id %>" class="small fw-semibold text-decoration-none text-dark">
                        <%= j.title %>
                      </a>
                      <div class="text-muted" style="font-size:11px">
                        by <%= j.postedBy?.name || '—' %>
                      </div>
                    </td>
                    <td class="small text-muted"><%= j.company %></td>
                    <td>
                      <span class="badge bg-primary bg-opacity-10 text-primary">
                        <%= j.type %>
                      </span>
                    </td>
                    <td>
                      <span class="badge <%= j.applyType === 'easy_apply' ? 'bg-warning bg-opacity-10 text-warning' : 'bg-info bg-opacity-10 text-info' %>">
                        <i class="bi <%= j.applyType === 'easy_apply' ? 'bi-lightning-charge-fill' : 'bi-box-arrow-up-right' %> me-1"></i>
                        <%= j.applyType === 'easy_apply' ? 'Easy Apply' : 'External' %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <!-- login activity -->
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header py-3">
          <span class="fw-semibold">
            <i class="bi bi-clock-history me-2 text-warning"></i>Recent Login Activity
          </span>
        </div>
        <% if (!logs.length) { %>
          <div class="card-body text-center text-muted py-5">
            <i class="bi bi-clock-history fs-1 d-block mb-3 opacity-25"></i>
            No login activity yet
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="">
                <tr>
                  <th class="small fw-semibold ps-3">Email</th>
                  <th class="small fw-semibold">Status</th>
                  <th class="small fw-semibold">Reason</th>
                  <th class="small fw-semibold">IP Address</th>
                  <th class="small fw-semibold">User Agent</th>
                  <th class="small fw-semibold">Time</th>
                </tr>
              </thead>
              <tbody>
                <% logs.forEach(log => { %>
                  <tr>
                    <td class="ps-3 small fw-semibold"><%= log.email %></td>
                    <td>
                      <span class="badge <%= log.status === 'success' ? 'bg-success' : 'bg-danger' %>">
                        <i class="bi <%= log.status === 'success' ? 'bi-check-circle' : 'bi-x-circle' %> me-1"></i>
                        <%= log.status %>
                      </span>
                    </td>
                    <td class="small text-muted"><%= log.reason || '—' %></td>
                    <td>
                      <code class="small"><%= log.ip || '—' %></code>
                    </td>
                    <td class="small text-muted" style="max-width:200px">
                      <span class="text-truncate d-block" title="<%= log.userAgent %>">
                        <%= log.userAgent ? log.userAgent.substring(0, 40) + '…' : '—' %>
                      </span>
                    </td>
                    <td class="small text-muted text-nowrap">
                      <%= new Date(log.createdAt).toLocaleString() %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>