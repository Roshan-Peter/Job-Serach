<%- include('../partials/header', { title: 'Job Listings' }) %>
<%- include('../partials/navbar') %>

<main class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-0">Job Listings</h2>
      <p class="text-muted small mb-0">
        <%= jobs.length %> open position<%= jobs.length !== 1 ? 's' : '' %>
      </p>
    </div>
  </div>

  <% if (!jobs.length) { %>

    <div class="text-center py-5 text-muted">
      <i class="bi bi-briefcase fs-1 d-block mb-3 opacity-25"></i>

      <p class="mb-0">No job listings yet.</p>

      <% if (user) { %>
        <a href="/jobs/create" class="btn btn-primary mt-3">
          Post the first job
        </a>
      <% } %>
    </div>

  <% } else { %>

    <div class="row g-4">

      <% jobs.forEach(job => { %>

        <div class="col-md-6">

          <a href="/jobs/<%= job._id %>" class="text-decoration-none">

            <div class="card shadow-sm border-0 h-100 job-card overflow-hidden">

              <div class="card-body p-4">

                <!-- title + badge -->
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">

                  <h5 class="fw-bold mb-0 text-break flex-grow-1">
                    <%= job.title %>
                  </h5>

                  <span class="badge flex-shrink-0
                    <%= job.applyType === 'easy_apply'
                      ? 'bg-warning bg-opacity-10 text-warning'
                      : 'bg-info bg-opacity-10 text-info' %>">

                    <i class="bi
                      <%= job.applyType === 'easy_apply'
                        ? 'bi-lightning-charge-fill'
                        : 'bi-box-arrow-up-right' %> me-1">
                    </i>

                    <%= job.applyType === 'easy_apply'
                      ? 'Easy Apply'
                      : 'External' %>

                  </span>

                </div>

                <!-- company/location -->
                <p class="text-muted small mb-3 text-break">

                  <i class="bi bi-building me-1"></i>
                  <span class="break-anywhere"><%= job.company %></span>

                  <span class="mx-1">·</span>

                  <i class="bi bi-geo-alt me-1"></i>
                  <span class="break-anywhere"><%= job.location %></span>

                </p>

                <!-- badges -->
                <div class="d-flex flex-wrap gap-2 mb-3">

                  <span class="badge bg-primary bg-opacity-10 text-primary text-wrap">
                    <%= job.type %>
                  </span>

                  <span class="badge bg-secondary bg-opacity-10 text-secondary text-wrap">
                    <%= job.experience %>
                  </span>

                  <% if (job.salary && (job.salary.min || job.salary.max)) { %>

                    <span class="badge bg-success bg-opacity-10 text-success text-wrap">

                      <%= job.salary.currency %>

                      <%= job.salary.min
                        ? Number(job.salary.min).toLocaleString()
                        : '' %>

                      <% if (job.salary.min && job.salary.max) { %>
                        –
                      <% } %>

                      <%= job.salary.max
                        ? Number(job.salary.max).toLocaleString()
                        : '' %>

                    </span>

                  <% } %>

                </div>

                <!-- skills -->
                <% if (job.skills && job.skills.length) { %>

                  <div class="d-flex flex-wrap gap-1">

                    <% job.skills.slice(0, 4).forEach(s => { %>

                      <span class="badge bg-light text-dark border text-wrap skill-badge">
                        <%= s %>
                      </span>

                    <% }) %>

                    <% if (job.skills.length > 4) { %>

                      <span class="badge bg-light text-muted border">
                        +<%= job.skills.length - 4 %> more
                      </span>

                    <% } %>

                  </div>

                <% } %>

              </div>

              <!-- footer -->
              <div class="card-footer bg-transparent border-0 px-4 pb-3">

                <small class="text-muted text-break">
                  <i class="bi bi-clock me-1"></i>

                  <%= new Date(job.createdAt).toLocaleDateString() %>
                </small>

              </div>

            </div>

          </a>

        </div>

      <% }) %>

    </div>

  <% } %>

</main>

<style>

  .job-card {
    transition: transform .15s, box-shadow .15s;
    border-radius: 1rem;
  }

  .job-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 .5rem 1rem rgba(0,0,0,.1) !important;
  }

  .text-break {
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .break-anywhere {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .skill-badge {
    max-width: 100%;
    white-space: normal;
  }

</style>

<%- include('../partials/footer') %>