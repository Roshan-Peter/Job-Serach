      //}



      // ── resume preview on select ───────────────────────────────────────────────
      const resumeSelect = document.getElementById('resumeSelect');
      const resumePreview = document.getElementById('resumePreview');
      const previewTitle = document.getElementById('previewTitle');
      const previewMeta = document.getElementById('previewMeta');
      const previewLink = document.getElementById('previewLink');

      // build a map from the EJS data
      const resumeMap = {};
  <% if (resumes && resumes.length) { %>
    <% resumes.forEach(r => { %>
        resumeMap['<%= r._id %>'] = {
          title: '<%= r.title %>',
            updated: '<%= r.updatedAt ? new Date(r.updatedAt).toLocaleDateString() : "" %>',
              url: '/resume/<%= r._id %>',
      };
    <% }) %>
  <% } %>

  if (resumeSelect) {
        resumeSelect.addEventListener('change', () => {
          const id = resumeSelect.value;
          if (!id) {
            resumePreview.classList.add('d-none');
            return;
          }
          const r = resumeMap[id];
          if (!r) return;
          previewTitle.textContent = r.title;
          previewMeta.textContent = r.updated ? `Last updated ${r.updated}` : '';
          previewLink.href = r.url;
          resumePreview.classList.remove('d-none');
        });
      }

      // ── apply form submit ──────────────────────────────────────────────────────
      const applyForm = document.getElementById('applyForm');

      if (applyForm) {
        applyForm.addEventListener('submit', async (e) => {
          e.preventDefault();

          const pathParts = window.location.pathname.split('/');
          const jobId = pathParts[pathParts.length - 1];

          const btn = document.getElementById('applyBtn');
          const btnText = document.getElementById('applyBtnText');
          const spinner = document.getElementById('applySpinner');
          const errEl = document.getElementById('applyError');
          const sucEl = document.getElementById('applySuccess');

          errEl.classList.add('d-none');
          sucEl.classList.add('d-none');
          btn.disabled = true;
          btnText.innerHTML = 'Submitting…';
          spinner.classList.remove('d-none');

          try {
            const form = new FormData(applyForm);

            // ✅ include selected resumeId
            const payload = {
              name: form.get('name'),
              email: form.get('email'),
              number: form.get('number'),
              url: form.get('url'),
              coverLetter: form.get('coverLetter'),
              resumeId: form.get('resumeId'),  // ✅
            };

            // validate resume selected
            if (!payload.resumeId) {
              throw new Error('Please select a resume before submitting');
            }

            const res = await fetch(`/jobs/${jobId}/apply`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            const data = await res.json();

            if (!res.ok) throw new Error(data.error || 'Failed to apply');

            sucEl.textContent = data.message || 'Application submitted successfully!';
            sucEl.classList.remove('d-none');
            applyForm.reset();
            resumePreview.classList.add('d-none');

            // disable button so they can't apply again
            btn.disabled = true;
            btnText.innerHTML = '<i class="bi bi-check-circle me-2"></i>Applied';

          } catch (err) {
            errEl.textContent = err.message;
            errEl.classList.remove('d-none');
          } finally {
            if (!sucEl.classList.contains('d-none')) return;
            btn.disabled = false;
            btnText.innerHTML = '<i class="bi bi-send me-2"></i>Submit Application';
            spinner.classList.add('d-none');
          }
        });
      }
    </script>

